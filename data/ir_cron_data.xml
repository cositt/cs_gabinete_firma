<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_pedir_firma_sesiones" model="ir.cron">
            <field name="name">Gabinetes: pedir firma de las sesiones de ayer</field>
            <field name="model_id" ref="documents.model_documents_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_cs_request_session_signatures()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="nextcall" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        </record>

    </data>
</odoo>
