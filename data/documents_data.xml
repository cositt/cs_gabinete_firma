<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- v18+: las carpetas son documents.document con type='folder' y las etiquetas
             ya no tienen faceta (documents.folder y documents.facet desaparecieron). -->
        <record id="documents_folder_gabinetes" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Gabinetes</field>
            <field name="sequence">15</field>
        </record>

        <record id="documents_tag_sesion" model="documents.tag">
            <field name="name">Sesión</field>
            <field name="sequence">10</field>
        </record>

        <record id="documents_tag_firmada" model="documents.tag">
            <field name="name">Firmada</field>
            <field name="sequence">20</field>
        </record>

    </data>
</odoo>
